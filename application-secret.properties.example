# 复制本文件为 application-secret.properties，填入真实值后再启动
# （application-secret.properties 已被 .gitignore 排除，不会进仓库）
#
# 也可以先空着启动：应用能跑起来，只是 AI 对话/识图/生图会提示"还没配 Key"。
# 会话页左下角「设置」里填好保存，会自动写回这个文件。

# ── AI 模型 Key ─────────────────────────────────────────────
# DeepSeek：https://platform.deepseek.com/api_keys
# DashScope（通义千问 / 万相）：https://bailian.console.aliyun.com/  → API-KEY 管理（地域选北京）
langchain4j.open-ai.chat-model.api-key=sk-your-deepseek-key
langchain4j.open-ai.streaming-chat-model.api-key=${langchain4j.open-ai.chat-model.api-key}
dashscope.api-key=sk-your-dashscope-key

# ── 数据库（可选，覆盖 application.properties 里的默认值） ───
# 默认连 localhost:3306/tiphon，账号 tiphon_app、空密码。
# 你的库账号密码不一样时，取消下面三行的注释再改。
#spring.datasource.url=jdbc:mysql://localhost:3306/tiphon?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
#spring.datasource.username=tiphon_app
#spring.datasource.password=你的库密码

# ── 店主账号初始密码（可选） ───────────────────────────────
# 不填的话首次启动会随机生成一个 12 位密码，在控制台日志里打印出来。
#tiphon.admin.password=你的后台密码